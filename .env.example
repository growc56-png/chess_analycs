# Copy to .env and replace the placeholders. Never commit .env.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE

# Optional: absolute or repository-relative path to the Stockfish executable.
# On Windows the bundled stockfish-windows-x86-64-universal.exe is auto-detected.
# After running scripts/install_stockfish.py, the new Stockfish 19 binary is used.
STOCKFISH_PATH=

# Stockfish resource limits (per backend process).
# Optional overrides; leave commented to use safe CPU-aware defaults.
# CHESS_ENGINE_THREADS=3
# CHESS_ENGINE_HASH_MB=256
# CHESS_BOT_ENGINE_THREADS=1
# CHESS_BOT_ENGINE_HASH_MB=64

# Game analysis (balanced defaults).
CHESS_ANALYSIS_DEPTH=18
CHESS_ANALYSIS_TIME=2.0
CHESS_DEEP_ANALYSIS_DEPTH=23
CHESS_DEEP_ANALYSIS_TIME=2.5
CHESS_MAX_DEEP_ANALYSIS_MOVES=16
CHESS_BRILLIANT_ANALYSIS_DEPTH=26
CHESS_BRILLIANT_ANALYSIS_TIME=4.0

# Single-position evaluation and protection against too many queued jobs.
CHESS_EVALUATE_DEPTH=15
CHESS_EVALUATE_TIME=1.2
CHESS_MAX_PENDING_ANALYSES=2
